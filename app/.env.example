# ============================================================
# NOUN Smart Lecture Reminder — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ---- Supabase (get from supabase.com → Project Settings → API) ----
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# ---- Web Push VAPID (generate once with: npx web-push generate-vapid-keys) ----
# Only the PUBLIC key goes here (safe to expose to the browser)
VITE_VAPID_PUBLIC_KEY=<your-vapid-public-key>

# ---- Internal secret for Supabase Edge Functions (cancel-notify, create-lecturer) ----
# Any random string — must match the CANCEL_NOTIFY_SECRET set via `supabase secrets set` below
VITE_CANCEL_NOTIFY_SECRET=<any-random-secret-string>
VITE_INTERNAL_SECRET=<same-random-secret-string>

# ---- Supabase service role key (used by supabase/scripts/*.mjs demo & seed scripts) ----
# NOT read by the Vite app itself — only by the standalone Node scripts run via
# `node --env-file=.env.local supabase/scripts/reset-demo.mjs` etc.
VITE_SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# ============================================================
# The following are NOT read from this file. They're server-side secrets for
# the Supabase Edge Functions (supabase/functions/) and are set once via:
#
#   npx supabase secrets set \
#     VAPID_PUBLIC_KEY=<your-vapid-public-key> \
#     VAPID_PRIVATE_KEY=<your-vapid-private-key> \
#     CANCEL_NOTIFY_SECRET=<same-as-VITE_INTERNAL_SECRET-above> \
#     CRON_SECRET=<any-random-secret-string, used by the send-reminders Supabase Cron job>
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected into every
# Edge Function by Supabase — do not set them yourself.
# ============================================================
